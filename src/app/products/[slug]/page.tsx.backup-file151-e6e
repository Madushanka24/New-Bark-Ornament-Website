  params,
}: ProductPageProps) {
  const { slug } = await params;

  /*
   * Resolve through the unified server-only
   * product resolver.
   *
   * Local products retain precedence.
   *
   * Approved CMS products remain gated.
   */

  const resolved =
    await resolveCatalogueProductBySlug(slug);

  if (!resolved) {
    notFound();
  }

  const {
    product,
    category,
    source,
  } = resolved;

  /*
   * Preserve original local recommendations.
   *
   * Do not recommend local demo products
   * on a future CMS-only public product.
   */

  const relatedInCategory =
    source === "local"
      ? getRelatedProducts(
          product,
          3,
          true
        )
      : [];

  /*
   * Existing related-product fallback.
   *
   * For local records, preserve previous
   * same-category and preview suggestions.
   *
   * CMS-only related products are held
   * until complete public route integration.
   */

