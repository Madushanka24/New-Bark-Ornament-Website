/**
 * BARK ORNAMENT — FILE 150 STEP E7Q
 *
 * PRODUCT DETAIL PAGE
 * Theme: Golden Coastal Luxury
 *
 * CMS INTEGRATION
 * - Resolve local products first.
 * - Prepare gated CMS-only product resolution.
 * - Use the same resolver for page and metadata.
 * - Preserve existing local product URLs.
 * - Keep unapproved CMS records excluded.
 *
 * NEXT.JS 16 INSTANT NAVIGATION
 * - URL-dependent content remains asynchronous.
 * - Async content stays inside Suspense.
 * - generateStaticParams preserves local routes.
 * - generateMetadata preserves canonical URLs.
 *
 * APPROVED PHOTOGRAPHY
 * - Main product image
 * - Additional view
 * - Material detail
 * - Finish detail
 * - Local approved-image fallback
 * - Related local product images
 *
 * PRESERVED FUNCTIONALITY
 * - Dynamic product routes
 * - Product SEO metadata
 * - Development preview restrictions
 * - Category breadcrumbs
 * - Product descriptions
 * - Materials, sizes and finishes
 * - Existing local Add to Quote behavior
 * - Related local product recommendations
 *
 * SAFETY
 * - CMS public integration remains disabled.
 * - No fabricated products or photographs.
 * - No direct database access.
 * - No new API endpoints.
 * - No email or quotation submission changes.
 * - CMS-only basket actions remain restricted
 *   until quotation compatibility is verified.
 */

type ProductPageProps = {
  params: Promise<{
    slug: string;
  }>;
};

/* ==========================================
   1. GENERATE PRODUCT ROUTES

   Preserve the existing local route list.

   CMS-only routes will be resolved at
   request time after public integration
   is explicitly activated.
   ========================================== */

export function generateStaticParams() {
  /*
   * Preserve local development previews.
   *
   * Never pre-generate draft/demo product
   * routes in production.
   */

  const developmentPreviewAllowed =
    process.env.NODE_ENV === "development" &&
    process.env.CATALOGUE_CMS_PUBLIC_ENABLED !== "true";

  const eligibleProducts =
    developmentPreviewAllowed
      ? products
      : products.filter(
          (product) =>
            product.status === "published" &&
            product.isDemo === false
        );

  if (eligibleProducts.length > 0) {
    return eligibleProducts.map((product) => ({
      slug: product.slug,
    }));
  }

  /*
   * Next.js 16 Cache Components requires
   * at least one static parameter.
   *
   * This value is not an actual product.
   * The existing guarded resolver returns
   * null, causing the page to call notFound().
   */

  const placeholderSlug =
    "catalogue-build-validation";

  if (
    products.some(
      (product) =>
        product.slug === placeholderSlug
    )
  ) {
    throw new Error(
      "Build validation slug conflicts with a real product."
    );
  }

  return [{ slug: placeholderSlug }];
}

/* ==========================================
   2. DYNAMIC PRODUCT SEO METADATA

   Use the same product resolver as the
   rendered detail page.

   Draft/demo products remain noindex.

   Unknown products remain noindex.
   ========================================== */

export async function generateMetadata({
  params,
}: ProductPageProps): Promise<Metadata> {
  const { slug } = await params;

  const resolved =
    await resolveCatalogueProductBySlug(slug);

  if (!resolved) {
    return {
      title: "Product Not Found",
      robots: {
        index: false,
        follow: false,
      },
    };
  }

  const { product } = resolved;

  return {
    alternates: {
      canonical: `/products/${product.slug}`,
    },
    title: product.name,
    description: product.shortDescription,
    robots: {
      index:
        product.status === "published" &&
        !product.isDemo &&
        resolved.indexable,
      follow: true,
    },
  };
}

/* ==========================================
   3. APPROVED PRODUCT PHOTO DISPLAY
