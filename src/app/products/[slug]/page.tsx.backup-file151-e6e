            )}

            <p className="mt-7 text-base leading-8 text-[#74675E]">
              {product.description}
            </p>

            <div className="mt-8 rounded-xl border border-[#E4D7C4] bg-[#FAF7F0] p-6">
              <h3 className="font-serif text-xl text-[#30251F]">
                Product Availability
