/**
 * Retains the existing product photograph
 * display interface and luxury placeholders.
 *
 * Approved image URLs are validated by
 * their corresponding image readers.
 */

function ProductPhotoPlaceholder({
  label,
  large = false,
  photo = null,
}: {
  label: string;
  large?: boolean;
  photo?: ApprovedPhoto | null;
}) {
  return (
    <ApprovedProductImage
      label={label}
      photo={photo}
      aspect="wide"
      fit="contain"
      sizes={
        large
          ? "(max-width: 1024px) 100vw, 960px"
          : "(max-width: 640px) 33vw, 260px"
      }
      className={
        large
          ? "min-h-[340px] border border-[#D9C8B0] sm:min-h-[460px]"
          : "min-h-[110px] border border-[#D9C8B0] sm:min-h-[135px]"
      }
    />
  );
}

